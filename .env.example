# Get a free key at https://the-odds-api.com (500 credits/month on the free tier).
# Leave blank to run with demo odds.
ODDS_API_KEY=

# Sportsbook to pull lines from (falls back to the first book available per game).
BOOKMAKER=draftkings

# How long to cache odds before re-fetching. Each fetch costs 3 credits
# (moneyline + spread + total), so 6h ~= 360 credits/month.
ODDS_CACHE_HOURS=6

# Optional shared code your friends must enter to use the site.
GROUP_CODE=

PORT=3000
