# Copy this file to .env and fill in what you need.

# Free key from https://the-odds-api.com. Pulls the schedule and your
# sportsbook's lines. Required for making picks.
ODDS_API_KEY=

# Who's in the group, comma-separated.
PLAYERS=Daniel,Asher,Matt

# Sportsbook to pull lines from: fanduel, draftkings, betmgm, williamhill_us (Caesars), ...
BOOKMAKER=fanduel

# Lines update at 11 AM and 6 PM Eastern (plus 2 manual refreshes on Sundays),
# props Thursday and Sunday at 11 AM. These caps are a backstop for lines.
# Most API credits line refreshes can spend per day (Eastern).
DAILY_CREDIT_LIMIT=16
# Same, on Sundays. 30 = 10 refreshes.
SUNDAY_CREDIT_LIMIT=30

# Logins: username:password pairs, comma-separated. Each username must match a
# player. Leave empty for no login. Set the real ones in Vercel (Settings ->
# Environment Variables), never in a file you commit: the repo is public.
LOGINS=
# Optional: signs login sessions. If empty, one is made from LOGINS.
SESSION_SECRET=

# Optional shared code your friends must enter to use the site.
GROUP_CODE=

PORT=3000

# Only needed to copy local data to the hosted site (npm run upload-data).
# Copy these from Vercel (Settings > Environment Variables) or the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
