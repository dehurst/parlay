# Copy this file to .env and fill in what you need.

# Free key from https://the-odds-api.com. Pulls the schedule and your
# sportsbook's lines. Required for making picks.
ODDS_API_KEY=

# Who's in the group, comma-separated.
PLAYERS=Daniel,Asher,Matt

# Sportsbook to pull lines from: fanduel, draftkings, betmgm, williamhill_us (Caesars), ...
BOOKMAKER=fanduel

# Hours between automatic line refreshes. Each refresh costs 3 credits
# (moneyline + spread + total); 6h uses at most ~360 of the free 500/month.
ODDS_CACHE_HOURS=6

# Optional shared code your friends must enter to use the site.
GROUP_CODE=

PORT=3000

# Only needed to copy local data to the hosted site (npm run upload-data).
# Copy these from Vercel (Settings > Environment Variables) or the Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
